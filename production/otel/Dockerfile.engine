# Reusable pattern for any BusinessOS engine.
# Build the jar first (./gradlew bootJar), then:
#   docker build -f Dockerfile.engine -t <engine> .
# Or copy this file into each engine repo as Dockerfile.

FROM eclipse-temurin:25-jre-alpine

RUN apk add --no-cache curl && \
    mkdir -p /opt/otel && \
    curl -fsSL -o /opt/otel/opentelemetry-javaagent.jar \
      https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/latest/download/opentelemetry-javaagent.jar && \
    apk del curl

WORKDIR /app
COPY *.jar app.jar

ENV OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317 \
    OTEL_EXPORTER_OTLP_PROTOCOL=grpc \
    OTEL_TRACES_EXPORTER=otlp \
    OTEL_METRICS_EXPORTER=none \
    OTEL_LOGS_EXPORTER=otlp \
    OTEL_TRACES_SAMPLER=parentbased_traceidratio \
    OTEL_TRACES_SAMPLER_ARG=0.1

ENTRYPOINT ["java", "-javaagent:/opt/otel/opentelemetry-javaagent.jar", "-jar", "/app/app.jar"]
