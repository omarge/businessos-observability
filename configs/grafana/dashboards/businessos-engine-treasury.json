{
  "uid": "businessos-engine-treasury",
  "title": "Treasury & Liquidity Engine (Multi-Tenant)",
  "tags": ["businessos", "treasury", "liquidity", "engine", "multitenancy"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(http_server_requests_seconds_count{job=~\".*treasury.*\"}, tenant)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "title": "Treasury Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (tenant, uri) (rate(http_server_requests_seconds_count{job=~\".*treasury.*\", tenant=~\"$tenant\"}[5m]))", "legendFormat": "{{tenant}} {{uri}}", "refId": "A"}]
    },
    {
      "title": "Treasury Latency p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (tenant, le) (rate(http_server_requests_seconds_bucket{job=~\".*treasury.*\", tenant=~\"$tenant\"}[5m])))", "legendFormat": "{{tenant}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "JVM Heap (Treasury)",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\", job=~\".*treasury.*\"}) / sum by (job) (jvm_memory_max_bytes{area=\"heap\", job=~\".*treasury.*\"}) * 100", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "title": "Treasury Errors (Logs)",
      "type": "logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 14},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{job=~\".*treasury.*\"} | json | tenant=~\"$tenant\" | level=~\"ERROR|WARN\"", "refId": "A"}]
    }
  ]
}
